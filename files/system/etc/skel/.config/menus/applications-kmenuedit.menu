   <Filename>net.lutris.Lutris.desktop</Filename>
   <Filename>bazzite-steam-bpm.desktop</Filename>
   <Filename>steam.desktop</Filename>
  </Layout>
  <Exclude>
   <Filename>BeamNG.drive.desktop</Filename>
  </Exclude>
 </Menu>
 <Menu>
  <Name>Help</Name>
  <Deleted/>
 </Menu>
 <Move>
  <Old>Internet</Old>
  <New>Development/Internet</New>
 </Move>
 <Menu>
  <Name>Internet</Name>
  <NotDeleted/>
  <Exclude>
   <Filename>app.zen_browser.zen.desktop</Filename>
   <Filename>bazzite-steam-bpm.desktop</Filename>
  </Exclude>
  <Layout>
   <Merge type="menus"/>
   <Menuname>Terminal</Menuname>
   <Merge type="files"/>
