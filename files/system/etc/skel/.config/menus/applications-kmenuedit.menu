   <Filename>dev.vencord.Vesktop.desktop</Filename>
   <Filename>webapp-manager.desktop</Filename>
   <Separator/>
   <Menuname>More</Menuname>
  </Layout>
 </Menu>
 <Move>
  <Old>Development/Internet</Old>
  <New>Internet</New>
 </Move>
 <Move>
  <Old>Development</Old>
  <New>Games/Development</New>
 </Move>
