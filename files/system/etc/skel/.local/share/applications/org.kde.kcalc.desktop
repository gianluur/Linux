[Desktop Entry]
Categories=Qt;KDE;Utility;Calculator;X-KDE-Utilities-Desktop;
Comment=Calculator which offers many mathematical functions, such as trigonometric functions, logic operations, and statistical calculations
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=kcalc org.kde.kcalc
GenericName=Scientific Calculator
Icon=org.kde.kcalc
Name=Calculator
NoDisplay=false
Path=
PrefersNonDefaultGPU=false
StartupNotify=true
Terminal=false
TerminalOptions=
Type=Application
X-DocPath=kcalc/index.html
X-Flatpak=org.kde.kcalc
X-KDE-Shortcuts=Calculator
X-KDE-SubstituteUID=false
X-KDE-Username=
